@@ -247,6 +247,14 @@ struct MmaBf16 {
     using Elem = __bf16;
     static constexpr int kFragElems = 8;
     static __forceinline__ __device__ int frag_base(int lane) { return 8 * (lane / 16); }
+    // The GEMM core's byte-addressed view: 16 bf16 elements are 32 bytes.
+    static constexpr int kStepBytes = 32;
+    static __forceinline__ __device__ Frag load(const void* lds, int row, int kbyte, int stride,
+                                                int lane) {
+        return load_frag_16bit<MmaBf16>(
+            reinterpret_cast<const __bf16*>(static_cast<const char*>(lds) + row * stride + kbyte),
+            lane);
+    }
     static __forceinline__ __device__ Acc zero() { return Acc{0, 0, 0, 0, 0, 0, 0, 0}; }
     static __forceinline__ __device__ Acc mma(Frag a, Frag b, Acc c) {
         return __builtin_amdgcn_wmma_f32_16x16x16_bf16_w32_gfx12(a, b, c);
@@ -358,6 +366,13 @@ struct MmaBf16 {
     using Elem = __bf16;
     static constexpr int kFragElems = 16;
     static __forceinline__ __device__ int frag_base(int) { return 0; }
+    static constexpr int kStepBytes = 32;
+    static __forceinline__ __device__ Frag load(const void* lds, int row, int kbyte, int stride,
+                                                int lane) {
+        return load_frag_16bit<MmaBf16>(
+            reinterpret_cast<const __bf16*>(static_cast<const char*>(lds) + row * stride + kbyte),
+            lane);
+    }
     static __forceinline__ __device__ Acc zero() { return Acc{0, 0, 0, 0, 0, 0, 0, 0}; }
     static __forceinline__ __device__ Acc mma(Frag a, Frag b, Acc c) {
         return __builtin_amdgcn_wmma_f32_16x16x16_bf16_w32(a, b, c);
@@ -430,6 +445,8 @@ struct MmaBf16 {
     using Elem = __bf16;
     static constexpr int kFragElems = 8;
     static __forceinline__ __device__ int frag_base(int) { return 0; }
+    static constexpr int kStepBytes = 32;
+    static __forceinline__ __device__ Frag load(const void*, int, int, int, int) { return Frag{}; }
     static __forceinline__ __device__ Acc zero() { return Acc{0, 0, 0, 0, 0, 0, 0, 0}; }
     static __forceinline__ __device__ Acc mma(Frag, Frag, Acc c) { COMFY_MMA_STUB_BODY }
     static __forceinline__ __device__ float get(Acc c, int e) { return c[e]; }
diff --git a/comfy_kitchen/backends/hip/ops/svdquant_w4a4.hip b/comfy_kitchen/backends/hip/ops/svdquant_w4a4.hip
index 107e46c07..db3a4fad2 100644
--- a/comfy_kitchen/backends/hip/ops/svdquant_w4a4.hip
+++ b/comfy_kitchen/backends/hip/ops/svdquant_w4a4.hip
@@ -26,72 +26,140 @@ namespace comfy::hip_backend {
 constexpr int kSvdGroup = 64;       // quantization group, in elements
 constexpr int kSvdGroupBytes = 32;  // ... and in packed int4 bytes
 
-// x @ proj_down -> (M, R), fp32. One thread per output column: proj_down is
-// (K, R), so consecutive threads read consecutive addresses.
+// x @ proj_down -> (M, R), fp32, with proj_down passed transposed as (R, K). A
+// 16-bit x runs on the WMMA GEMM core; this kernel is the fp32 path. R is narrow,
+// so a block covers a 32-row by 32-rank output tile and walks K through LDS, each
+// thread holding a 2x2 tile.
+constexpr int kLoraRows = 32;
+constexpr int kLoraRanks = 32;
+constexpr int kLoraK = 64;
+
 __global__ __launch_bounds__(256) void lora_down_kernel(
-    const void* __restrict__ x, const void* __restrict__ lora_down,
-    float* __restrict__ lora_act, int M, int K, int R, int x_code, int d_code) {
+    const float* __restrict__ x, const float* __restrict__ down_t, float* __restrict__ lora_act,
+    int M, int K, int R) {
+
+    // Each thread stages 8 consecutive K elements of one x row and of one down_t row.
+    static_assert(kLoraRows * kLoraK == 256 * 8 && kLoraK * kLoraRanks == 256 * 8,
+                  "one 8-element run per thread per operand");
+    // +1 keeps the half-wave's two x rows on distinct banks.
+    __shared__ float xs[kLoraRows][kLoraK + 1];
+    __shared__ float ds[kLoraK][kLoraRanks];
 
-    const int m = blockIdx.x;
-    const int r = threadIdx.x;
-    if (r >= R) return;
+    const int tid = threadIdx.x;
+    const int m0 = blockIdx.x * kLoraRows;
+    const int r0 = blockIdx.y * kLoraRanks;
+    const int ty = tid / 16;
+    const int tx = tid % 16;
+
+    const int xr = tid / (kLoraK / 8);
+    const int xk = tid % (kLoraK / 8) * 8;
+    const int dt = tid / (kLoraK / 8);
+    const int dk = tid % (kLoraK / 8) * 8;
+    const bool x_ok = m0 + xr < M;
+    const bool d_ok = r0 + dt < R;
+    const float* xrow = x + static_cast<int64_t>(x_ok ? m0 + xr : 0) * K + xk;
+    const float* drow = down_t + static_cast<int64_t>(d_ok ? r0 + dt : 0) * K + dk;
+
+    float xv[8], dv[8];
+    auto load = [&](int k0) {
+        #pragma unroll
+        for (int i = 0; i < 8; ++i) {
+            xv[i] = x_ok ? xrow[k0 + i] : 0.0f;
+            dv[i] = d_ok ? drow[k0 + i] : 0.0f;
+        }
+    };
+
+    float acc[2][2] = {};
+    load(0);
+    for (int k0 = 0; k0 < K; k0 += kLoraK) {
+        #pragma unroll
+        for (int i = 0; i < 8; ++i) {
+            xs[xr][xk + i] = xv[i];
+            ds[dk + i][dt] = dv[i];
+        }
+        __syncthreads();
+        if (k0 + kLoraK < K) load(k0 + kLoraK);
+
+        #pragma unroll 8
+        for (int k = 0; k < kLoraK; ++k) {
+            const float a0 = xs[ty * 2][k];
+            const float a1 = xs[ty * 2 + 1][k];
+            const float b0 = ds[k][tx * 2];
+            const float b1 = ds[k][tx * 2 + 1];
+            acc[0][0] = fmaf(a0, b0, acc[0][0]);
+            acc[0][1] = fmaf(a0, b1, acc[0][1]);
+            acc[1][0] = fmaf(a1, b0, acc[1][0]);
+            acc[1][1] = fmaf(a1, b1, acc[1][1]);
+        }
+        __syncthreads();
+    }
 
-    float sum = 0.0f;
-    for (int k = 0; k < K; ++k) {
-        sum += load_in(x, static_cast<int64_t>(m) * K + k, x_code) *
-               load_in(lora_down, static_cast<int64_t>(k) * R + r, d_code);
+    #pragma unroll
+    for (int i = 0; i < 2; ++i) {
+        const int m = m0 + ty * 2 + i;
+        if (m >= M) continue;
+        #pragma unroll
+        for (int j = 0; j < 2; ++j) {
+            const int t = r0 + tx * 2 + j;
+            if (t < R) lora_act[static_cast<int64_t>(m) * R + t] = acc[i][j];
+        }
     }
-    lora_act[static_cast<int64_t>(m) * R + r] = sum;
 }
 
