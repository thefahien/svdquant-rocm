@@ -183,23 +293,21 @@ __global__ __launch_bounds__(256) void svdquant_gemm_kernel(
             }
 
             // Flush the group: rescale the int32 accumulator into fp32.
-            const int g = kb0 / kSvdGroupBytes + grp;
