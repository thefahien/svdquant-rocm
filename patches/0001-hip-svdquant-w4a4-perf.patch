             }
         }
 
@@ -207,28 +315,65 @@ __global__ __launch_bounds__(256) void svdquant_gemm_kernel(
             __syncthreads();
             sa.store(As);
             sb.store(Bs);
+            as_s[s_grp][s_idx] = a_next;
+            ws_s[s_grp][s_idx] = w_next;
