@@ -148,7 +258,7 @@ __global__ __launch_bounds__(256) void svdquant_gemm_kernel(
                       "an int4 K-step must divide the quantization group");
 
         #pragma unroll
-        for (int grp = 0; grp < BKB / kSvdGroupBytes; ++grp) {
+        for (int grp = 0; grp < kGroups; ++grp) {
