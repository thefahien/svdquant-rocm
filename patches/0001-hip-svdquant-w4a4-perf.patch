From: 0xDELUXA <djernovevo@gmail.com>
Date: Tue, 20 Oct 2026 00:20:35 +0300
Subject: [PATCH] Optimize HIP SVDQuant W4A4 kernels

---
 comfy_kitchen/backends/hip/__init__.py        |   7 +-
 comfy_kitchen/backends/hip/mma.h              |  17 +
 .../backends/hip/ops/svdquant_w4a4.hip        | 330 +++++++++++++-----
 tests/test_hip_wmma.py                        |  32 +-
 4 files changed, 305 insertions(+), 81 deletions(-)

diff --git a/comfy_kitchen/backends/hip/__init__.py b/comfy_kitchen/backends/hip/__init__.py
index 71742c6ad..c1ed2e266 100644
--- a/comfy_kitchen/backends/hip/__init__.py
+++ b/comfy_kitchen/backends/hip/__init__.py
@@ -1522,8 +1522,13 @@ def quantize_svdquant_w4a4(
         _dl(xc), _dl(smooth), _dl(q), _dl(ascales),
         m, m_pad, k, act_unsigned, _stream(x),
     )
+    # The kernel takes proj_down as (R, K) in x's dtype: the (N, K) weight layout of
+    # the WMMA GEMM core. Without matrix cores a 16-bit x takes the fp32 kernel.
+    if lora_src.dtype != torch.float32 and not has_wmma():
+        lora_src = lora_src.float()
+    down_t =_aligned(lora_down.to(lora_src.dtype).t().contiguous())
     _C.svdquant_lora_down(
-        _dl(lora_src), _dl(lora_down), _dl(lora_act[:m]), m, k, r, _stream(x)
+        _dl(lora_src), _dl(down_t), _dl(lora_act[:m]), m, k, r, _stream(x)
     )
     return q, ascales, lora_act
 
diff --git a/comfy_kitchen/backends/hip/mma.h b/comfy_kitchen/backends/hip/mma.h
